#!/usr/bin/env bash
# ==============================================================================
# omarchy-recon: Fast native frosted-glass file & directory explorer overlay
#
# omarchy:summary=Fast native frosted-glass file search and launcher with instant preview and auto-copy
# omarchy:group=file
# omarchy:name=recon
# omarchy:args=[path]
# omarchy:examples=omarchy-recon|omarchy-recon /run/media/hp/SSS
# ==============================================================================
set -euo pipefail

dir="${1:-}"

if [[ "$dir" == "-h" || "$dir" == "--help" ]]; then
  cat <<'EOF'
omarchy-recon: Native Omarchy frosted-glass file & directory finder overlay

Usage:
  omarchy-recon [path]
  omarchy-shell shell toggle waldseelen.recon

Shortcuts inside Recon:
  [Enter]            Open file or folder in default application
  [Shift+Enter]      Copy absolute path to Wayland clipboard
  [Alt+Enter]        Reveal file in parent folder
  [Alt+A]            Open Power Actions menu (Terminal, VS Code, Copy, Info, Trash)
  [F2]               Inline rename file/folder
  [Ctrl+N]           Create new file / folder
  [Tab / Shift+Tab]  Cycle category filter tabs
  [Del / Ctrl+D]     Move item to trash (gio trash)
  [Ctrl+C]           Copy file path
  [Esc]              Clear search query / close overlay
  [Mouse Select]     Select and copy text directly inside the preview pane
EOF
  exit 0
fi

if [[ -n "$dir" ]]; then
  abs_dir="$(cd "$dir" 2>/dev/null && pwd || echo "$dir")"
  omarchy-shell shell toggle waldseelen.recon "{\"dir\": \"$abs_dir\"}"
else
  omarchy-shell shell toggle waldseelen.recon
fi
